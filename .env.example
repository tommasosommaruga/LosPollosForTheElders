# Copy to .env (git-ignored) and adjust. Read by `python -m medicine_buddy.main`.
# Real environment variables always win over this file.

# --- Robot -------------------------------------------------------------------
# Robot IP / hostname when the app runs on a LAPTOP (not needed when the app runs on
# the robot itself). `medicine-buddy`'s find step: reachy-mini.local may resolve to an
# IPv6 address on Windows - use the IPv4 address instead (see the main README).
REACHY_HOST=reachy-mini.local
# Laptop-only: media path into the robot. On many Macs GStreamer WebRTC crashes — use no_media
# when running from the laptop, or leave unset (main.py defaults to no_media on macOS + --host).
# On the robot itself, leave this unset / default.
# REACHY_MINI_MEDIA_BACKEND=no_media

# --- Medicine Buddy API / status page ----------------------------------------
# Keep 127.0.0.1: the Family settings page and voice transcripts must stay local.
MEDICINE_BUDDY_HOST=127.0.0.1
MEDICINE_BUDDY_PORT=8787
# Database file. Default: apps/medicine_buddy/data/medicine_buddy.db in a source checkout,
# ~/.local/share/medicine-buddy/medicine_buddy.db when installed (e.g. on the robot).
# MEDICINE_BUDDY_DB=
# Time zone used for reminders. A robot usually runs on UTC, which would make "9 AM" fire at the wrong
# hour. The Family settings page can also set it (that choice wins over this value).
# MEDICINE_BUDDY_TZ=Europe/Zurich
# Reachy speaks up by itself when a dose is due (1) or only answers when asked (0).
MEDICINE_BUDDY_REMINDERS=1
# 1 = a due reminder interrupts the conversation; 0 = wait for a pause
MEDICINE_BUDDY_REMINDER_INTERRUPT=1
# Companion wellbeing check-ins when the room is quiet (1/0). Quiet hours / interval also on Family page.
MEDICINE_BUDDY_CHECKINS=1
# MEDICINE_BUDDY_CHECKIN_HOURS=3
# MEDICINE_BUDDY_CHECKIN_QUIET_START=21:00
# MEDICINE_BUDDY_CHECKIN_QUIET_END=08:00
# Missed-dose push to caregivers: ntfy topic or any webhook that accepts POST (plain text body).
# Also configurable on the Family settings page (that choice wins over this value).
# MEDICINE_BUDDY_ALERT_URL=https://ntfy.sh/your-family-topic
# MEDICINE_BUDDY_ALERTS=1
# Encourage taking the box from the tray before offering the arm (1/0; Family page wins).
# MEDICINE_BUDDY_ENCOURAGE_SELF=1
# Optional light activity suggestions (1/0).
# MEDICINE_BUDDY_ACTIVITY_NUDGES=1
# On app start: a short wake line + which medicines are due in the next 30 minutes (1/0).
MEDICINE_BUDDY_WAKE_GREETING=1
# Background pull of a pasted ICS import URL (Family page). Medicine items stay proposals until Accept.
MEDICINE_BUDDY_CALENDAR_SYNC=1
# Google Calendar WRITE (voice create/cancel). ICS subscribe cannot push events.
# One-time: python3 scripts/google_calendar_oauth.py  (enable Calendar API + Desktop OAuth client;
# redirect URI http://127.0.0.1:8765/). Calendar id also settable on Family page.
# MEDICINE_BUDDY_GOOGLE_CLIENT_ID=
# MEDICINE_BUDDY_GOOGLE_CLIENT_SECRET=
# MEDICINE_BUDDY_GOOGLE_REFRESH_TOKEN=
# MEDICINE_BUDDY_GOOGLE_CALENDAR_ID=
# Detailed logs (also switchable on the in-app Debug page).
# MEDICINE_BUDDY_DEBUG=1
# Master switch: require spoken passphrases + voice-guard for medicine/memory changes (1/0).
# Default 0 (demo-friendly). Flip on the Family settings page too — that choice is stored in the DB
# and wins over this value. Keeps all passphrase code; one flag turns every guardrail on or off.
MEDICINE_BUDDY_REQUIRE_PASSPHRASES=0
# In-app UI (/medicine): default 0 = open Dashboard / Database / History / Family / Debug with no login.
# Set 1 to require any registered person's passphrase (not caregiver-only).
# MEDICINE_BUDDY_REQUIRE_UI_LOGIN=0
# Speech-layer checks when passphrases are required (prompt-injection protection). Overridden to off
# when MEDICINE_BUDDY_REQUIRE_PASSPHRASES is 0 / disabled in Family settings.
MEDICINE_BUDDY_VOICE_GUARD=1
# Allowed medicine names (default: the bundled medicine_catalog.json).
# MEDICINE_BUDDY_CATALOG=
# Maker Arm PC: after the person confirms "bring it?", Buddy POSTs structured JSON
# (schema medicine_buddy.arm.v1) to these paths on the arm:
#   POST {ARM_URL}/v1/dispense      → locate + pick_to_bowl + verify_place (one-shot)
#   POST {ARM_URL}/v1/check_taken   → one-shot camera: did they take it?
# Leave empty for FakeArm demo mode.
# MEDICINE_BUDDY_ARM_URL=http://172.24.0.187:9090
# MEDICINE_BUDDY_DRY_RUN=0
# Demo smooth (default on): bring named meds without a schedule; unknown labels → dispense.
# MEDICINE_BUDDY_DEMO_SMOOTH=1
# Arm async (default on): /doses/run returns immediately; Reachy keeps listening.
# MEDICINE_BUDDY_ARM_ASYNC=1
# Arm-first reminders (0 = offer arm first, skip "take it yourself"):
# MEDICINE_BUDDY_ENCOURAGE_SELF=0
# If the arm PC has no /v1/move_object, force bottles through /v1/dispense by name:
# MEDICINE_BUDDY_ARM_MOVE_VIA=dispense
# Timed manual probe: ./integrations/arm/probe_dispense.sh ["small bottle"]
# On the robot, install syncs this into ~/.local/share/medicine-buddy/.env:
#   scripts/install_on_robot.sh reachy-mini.local local
# MEDICINE_BUDDY_ARM_TIMEOUT_S=90
# Voice-tool HTTP wait for arm paths (default 100; must be >= ARM_TIMEOUT_S):
# MEDICINE_BUDDY_ARM_TOOL_TIMEOUT_S=100
# MEDICINE_BUDDY_ADHERENCE_TIMEOUT_S=8
# Arm PC listener (stdlib only): python3 integrations/arm/arm_listener.py

# --- Conversation app (Pollen) ----------------------------------------------
# The default Hugging Face realtime backend needs no key. Optional:
# HF_TOKEN=
# Turn the camera tool off ("what do you see?" / read_document), e.g. to test camera delay:
# REACHY_MINI_CAMERA_ENABLED=0
# Document OCR (read_document): also needs `pip install '.[ocr]'` and system Tesseract
# (macOS: brew install tesseract).
# REALTIME_TRANSCRIPTION_LANGUAGE=en
