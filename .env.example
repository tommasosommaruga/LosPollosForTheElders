# Copy to .env (git-ignored) and adjust. Read by `python -m medicine_buddy.main`.
# Real environment variables always win over this file.

# --- Robot -------------------------------------------------------------------
# Robot IP / hostname when the app runs on a LAPTOP (not needed when the app runs on
# the robot itself). `medicine-buddy`'s find step: reachy-mini.local may resolve to an
# IPv6 address on Windows - use the IPv4 address instead (see the main README).
REACHY_HOST=reachy-mini.local

# --- Medicine Buddy API / status page ----------------------------------------
# Keep 127.0.0.1: the Family settings page and voice transcripts must stay local.
MEDICINE_BUDDY_HOST=127.0.0.1
MEDICINE_BUDDY_PORT=8787
# Database file. Default: apps/medicine_buddy/data/medicine_buddy.db in a source checkout,
# ~/.local/share/medicine-buddy/medicine_buddy.db when installed (e.g. on the robot).
# MEDICINE_BUDDY_DB=
# Medicine changes only when the person really said so (prompt-injection protection).
MEDICINE_BUDDY_VOICE_GUARD=1
# Allowed medicine names (default: the bundled medicine_catalog.json).
# MEDICINE_BUDDY_CATALOG=

# --- Conversation app (Pollen) ----------------------------------------------
# The default Hugging Face realtime backend needs no key. Optional:
# HF_TOKEN=
# REALTIME_TRANSCRIPTION_LANGUAGE=en
